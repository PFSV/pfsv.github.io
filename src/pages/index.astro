---
import Layout from '../layouts/Layout.astro';
import { experience, honors, profile, projects, publications, service } from '../lib/site';

const featured = projects.slice(0, 3);
---

<Layout>
  <section class="academic-hero">
    <p class="eyebrow">Applied NLP · Grounded AI · Seoul</p>
    <h1>{profile.name}</h1>
    <p class="hero-role">AI Research Engineer at MAUM.AI</p>
    <p class="lede">
      I build reliable language systems for real operating environments. My work spans grounded
      retrieval, query expansion, agent systems, model adaptation, evaluation, and serving—guided
      by an earlier research background in language, cognition, and neural representation.
    </p>
    <div class="actions">
      <a class="button primary" href={profile.cv}>Full CV · PDF</a>
      <a class="button" href={profile.github}>GitHub</a>
      <a class="button" href={profile.huggingFace}>Hugging Face</a>
      <a class="button" href={profile.orcid}>ORCID</a>
      <a class="button" href={`mailto:${profile.email}`}>Email</a>
    </div>
  </section>

  <section class="section" id="publications">
    <header class="section-head">
      <div>
        <p class="eyebrow">Research</p>
        <h2>Publications</h2>
      </div>
      <a class="quiet-link" href="/research/">Research details →</a>
    </header>
    <div class="publication-list">
      {publications.map((publication, index) => (
        <article class="publication">
          <span class="pub-number">P{publications.length - index}</span>
          <div>
            <h3><a href={publication.href}>{publication.title}</a></h3>
            {index === 0 && <p class="authors"><strong>Hyeonseop Yoon</strong>, Jeong-Eun Park</p>}
            <p class="venue">{publication.venue}</p>
            <div class="paper-links"><a href={publication.href}>Paper ↗</a></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="work">
    <header class="section-head">
      <div><p class="eyebrow">Engineering</p><h2>Selected work</h2></div>
      <a class="quiet-link" href="/work/">All work & evidence →</a>
    </header>
    <div class="grid">
      {featured.map((project) => (
        <article class="card project-card">
          <span class="badge">{project.evidence}</span>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <p class="meta">{project.result}</p>
          <a class="quiet-link" href={`/work/#${project.slug}`}>Details →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="experience">
    <header class="section-head"><div><p class="eyebrow">Background</p><h2>Experience</h2></div></header>
    <div class="resume-list">
      {experience.map((item) => (
        <article class="resume-row">
          <time>{item.period}</time>
          <div><h3>{item.organization}</h3><p class="resume-role">{item.role}</p><p>{item.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section two-column-section">
    <div>
      <p class="eyebrow">Recognition</p><h2>Selected honors</h2>
      <ul class="compact-list">
        {honors.map((item) => <li><span>{item.year}</span><div><strong>{item.title}</strong><br /><small>{item.issuer}{item.detail && ` · ${item.detail}`}</small></div></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Community</p><h2>Academic service</h2>
      <ul class="compact-list">
        {service.map((item) => <li><span>{item.year}</span><div><strong>{item.role}</strong><br /><small>{item.venue}</small></div></li>)}
      </ul>
    </div>
  </section>
</Layout>
